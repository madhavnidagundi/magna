# ===========================================
# Magna Monitoring Stack - Configuration
# ===========================================
# Copy this file or rename to .env and adjust values as needed.
# docker compose automatically reads from .env in the same directory.

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3000

# --- Prometheus ---
PROMETHEUS_PORT=9091

# --- Scrape Target ---
# The host:port where the Magna middleware exposes Prometheus metrics.
# Default uses host.docker.internal to reach services on the Docker host.
MAGNA_METRICS_TARGET=host.docker.internal:9090
